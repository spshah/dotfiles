# Aliases File.

alias so='source'
alias pwd='echo $PWD'
alias grep='grep -i'

alias .='echo $PWD'
alias ..='cd ..' # Simplified; Bash tracks previous directories automatically
alias tmux="tmux -2"
alias valgrind='valgrind --leak-check=yes --track-fds=yes'

# SVN Diff filtered for changes
svndiff() {
    svn diff "$@" | grep "^[+-]"
}

# Find in C++/C source files
findinsrc() {
    find . \( -name "*.cxx" -o -name "*.hxx" -o -name "*.tcl" -o -name "*.h" -o -name "*.c" -o -name "*.cpp" -o -name "*.hpp" -o -name "*.l" -o -name "*.y" -o -name "Makefil*" \) -exec grep "$@" {} /dev/null \;
}

# Find in Web/JS files
fz() {
    find . \( -name "*.py" -o -name "*.html" -o -name "*.pt" -o -name "*.js" -o -name "*.zcml" \) -exec grep "$@" {} /dev/null \;
}

# Language specific searches
findinpython() { find . -name "*.py" -exec grep "$@" {} /dev/null \;; }
findinperl()   { find . -name "*.pl" -exec grep "$@" {} /dev/null \;; }
findinall()    { find . -exec grep "$@" {} /dev/null \;; }

# Search for a specific filename in a directory: findfileindir [dir] [pattern]
findfileindir() {
    find "$1" -name "$2" -print
}

# Search for text inside a specific directory: findindir [dir] [pattern]
findindir() {
    find "$1" -exec grep "$2" {} /dev/null \;
}

# Remove Vim swap files safely
removeswapfiles() {
    find . -name "*.swp" -delete
}
